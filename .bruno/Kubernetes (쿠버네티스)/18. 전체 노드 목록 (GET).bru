meta {
  name: 18. 전체 노드 목록 (GET)
  type: http
  seq: 18
}

get {
  url: {{baseUrl}}/v1/nodes
  body: none
  auth: none
}

params:query {
  ~clusterName: {{cluster_name}}
  ~provider: {{provision_provider}}
  ~page: 0
  ~size: 50
}

docs {
  cluster 를 가로질러 노드를 한 번에 봅니다. cluster 별 조회는
  /v1/clusters/{clusterName}/namespaces/-/nodes 입니다.
}

tests {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
