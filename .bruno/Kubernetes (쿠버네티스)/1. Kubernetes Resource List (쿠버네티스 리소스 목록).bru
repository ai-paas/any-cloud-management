meta {
  name: 1. Kubernetes Resource List (쿠버네티스 리소스 목록)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/namespaces/{{namespace}}/{{resource_kind}}?pageSize=100
  body: none
  auth: none
}

params:query {
  pageSize: 100
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  namespace: default
  resource_kind: pods
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Paged 응답 envelope 확인", function() {
    const data = res.getBody();
    expect(data.success).to.equal(true);
    expect(data.data).to.have.property("items");
    expect(data.data).to.have.property("continueToken");
  });
}
