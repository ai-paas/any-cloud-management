meta {
  name: 1. Cluster List (클러스터 목록)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/clusters?source=registered
  body: none
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

script:post-response {
  // v1 응답: data.items 가 PagedData<UnifiedClusterDto>
  if (res.body && res.body.data && Array.isArray(res.body.data.items) && res.body.data.items.length > 0) {
    bru.setEnvVar("cluster_name", res.body.data.items[0].clusterName);
  }
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data).to.have.property("success");
    expect(data).to.have.property("data");
  });
}
