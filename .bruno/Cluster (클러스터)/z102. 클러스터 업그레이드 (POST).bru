  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/upgrade
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "targetImage": "{{agent_image}}"
  }
}

docs {
  `POST /v1/clusters/{clusterName}/upgrade`
}
