meta {
  name: 2b. Cluster Import Kubeconfig (strict mode)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/clusters/importKubeconfig?validate=true&strict=true
  body: multipartForm
  auth: none
}

headers {
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

params:query {
  validate: true
  strict: true
}

body:multipartForm {
  clusterName: imported-cluster-strict
  provider: AWS
  clusterType: EKS
  description: strict 모드 — 연결성 검증 실패 시 등록 rollback
  kubeconfigFile: @file({{kubeconfig_file_path}})
}

vars:pre-request {
  kubeconfig_file_path: ~/.kube/config
}

docs {
  strict=true:
    - 연결 OK → 201 + SUCCEEDED + connectivityCheck.connected=true
    - 연결 실패 → 422 + FAILED + cluster 등록 rollback (delete)

  의도적 실패 테스트: 잘못된 kubeconfig (예: 만료된 토큰 / 도달 불가능한 server)
  를 업로드하면 422 + Operation FAILED 를 받는다.
}

script:post-response {
  // 201 (성공) 일 때만 cluster_name 갱신. 422 (rollback) 이면 그대로 유지.
  if (res && res.getStatus() === 201 && res.body && res.body.data) {
    const d = res.body.data;
    if (d.resourceId) bru.setEnvVar('cluster_name', d.resourceId);
    if (d.id) bru.setEnvVar('last_operation_id', d.id);
  }
}

tests {
  test("status 201 OR 422 (연결 성공/실패에 따름)", function() {
    expect([201, 422]).to.include(res.getStatus());
  });

  test("422 인 경우 rollback 확인 (Operation FAILED)", function() {
    if (res.getStatus() === 422) {
      const body = res.getBody();
      expect(body.data.state).to.equal("FAILED");
      expect(body.message).to.match(/connectivity check failed/i);
    }
  });
}
