meta {
  name: 클러스터 capability 변경 (PATCH)
  type: http
  seq: 101
}

patch {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/capabilities
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
}

body:json {
  {
    "capabilities": [
      "EXEC_POD"
    ]
  }
}

docs {
  `PATCH /v1/clusters/{clusterName}/capabilities`
}
