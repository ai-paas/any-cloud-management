meta {
  name: 2a. Cluster Import Kubeconfig (multipart)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/clusters/importKubeconfig?validate=true&strict=false
  body: multipartForm
  auth: none
}

headers {
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

params:query {
  validate: true
  strict: false
}

body:multipartForm {
  clusterName: imported-cluster-001
  provider: AWS
  clusterType: EKS
  description: kubeconfig 파일 업로드로 등록한 클러스터
  kubeconfigFile: @file({{kubeconfig_file_path}})
}

vars:pre-request {
  kubeconfig_file_path: ~/.kube/config
}

docs {
  Query params:
    validate (default true)  — 등록 직후 K8s API 연결성 검증을 수행.
    strict   (default false) — 검증 실패 시 cluster 등록을 rollback (true) / 유지(false).

  Soft mode (strict=false) 는 검증 실패해도 201 + Operation SUCCEEDED 반환하고
    resultPayload.connectivityCheck.connected=false 로 기록한다.
  Strict mode (strict=true) 는 검증 실패 시 등록을 rollback 하고 422 + Operation FAILED 반환.
}

script:post-response {
  // import 성공 시 cluster_name / operation id 둘 다 promotion.
  if (res && res.body && res.body.data) {
    const d = res.body.data;
    if (d.resourceId) bru.setEnvVar('cluster_name', d.resourceId);
    if (d.id) bru.setEnvVar('last_operation_id', d.id);
  }
}

tests {
  test("status 201 (soft mode: 등록 즉시 완료)", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("Operation 응답 확인", function() {
    const body = res.getBody();
    expect(body.data.type).to.equal("CREATE_CLUSTER");
    expect(body.data.state).to.equal("SUCCEEDED");
    expect(body.links).to.have.property("resource");
  });

  test("connectivityCheck 결과 포함 (validate=true)", function() {
    const body = res.getBody();
    const payload = body.data.resultPayload;
    if (typeof payload === "string") {
      const obj = JSON.parse(payload);
      expect(obj).to.have.property("connectivityCheck");
      expect(obj.connectivityCheck.performed).to.equal(true);
    }
  });
}
