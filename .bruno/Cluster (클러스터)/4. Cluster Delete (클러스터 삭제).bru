meta {
  name: 4. Cluster Delete (클러스터 삭제)
  type: http
  seq: 4
}

delete {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}
  body: none
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  cluster_name: orb-kubernetes-001
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data).to.have.property("success");
    expect(data).to.have.property("data");
    expect(data.data.operation).to.equal("delete");
  });
}
