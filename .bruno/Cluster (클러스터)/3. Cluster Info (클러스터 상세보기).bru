meta {
  name: 3. Cluster Info (클러스터 상세보기)
  type: http
  seq: 5
}

get {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}
  body: none
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data).to.have.property("success");
    expect(data).to.have.property("data");
  });
}
