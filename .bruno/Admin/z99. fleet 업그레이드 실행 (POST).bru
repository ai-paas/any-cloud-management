meta {
  name: z99. fleet 업그레이드 실행 (POST)
  type: http
  seq: 101
}

post {
  url: {{baseUrl}}/v1/fleet/upgrade
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

body:json {
  {
    "targetImage": "ghcr.io/ai-paas/cluster-agent:latest",
    "waves": ["CANARY", "STAGING", "GENERAL"],
    "concurrency": 3,
    "failureThreshold": 30
  }
}

docs {
  run 을 등록만 하고 바로 돌아옵니다. 실제 진행은 orchestrator 가 15초 주기로 한 걸음씩 밉니다.
  호출이 성공해도 업그레이드가 끝난 것이 아니므로 z96 으로 진행 상황을 봅니다.

  한 wave 의 cluster 가 모두 끝나야 다음 wave 로 넘어가고, 실패율이 failureThreshold 를 넘으면
  run 전체를 중단합니다. wave 배정은 z95 로 먼저 확인하세요.
}

script:post-response {
  const id = res.getBody()?.data?.runId;
  if (id) bru.setEnvVar("fleet_upgrade_run_id", id);
}

tests {
  test("실행이 등록된다", function() {
    expect(res.getStatus()).to.be.oneOf([200, 202]);
    expect(res.getBody().data).to.have.property("runId");
  });
}
