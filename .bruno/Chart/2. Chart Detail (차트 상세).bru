meta {
  name: 2. Chart Detail (차트 상세)
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/helm-repos/{{repo_name}}/charts/{{chart_name}}?version={{chart_version}}
  body: none
  auth: none
}

params:query {
  version: {{chart_version}}
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  repo_name: chart-museum-external
  chart_name: ingress-nginx
  chart_version: 4.15.1
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data.success).to.equal(true);
    expect(data.status).to.equal(200);
    expect(data).to.not.be.undefined;
    expect(data.data).to.not.be.undefined;
  });
  
  test("차트 상세 정보 확인", function() {
    const data = res.getBody();
    if (data.data) {
      expect(data.data).to.have.property('name');
      expect(data.data).to.have.property('description');
    }
  });
}
