meta {
  name: 4. Chart README (차트 README)
  type: http
  seq: 4
}

get {
  url: {{baseUrl}}/v1/helm-repos/{{repo_name}}/charts/{{chart_name}}/readme?version={{chart_version}}
  body: none
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  repo_name: chart-museum-external
  chart_name: ingress-nginx
  chart_version: 4.15.1
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data.success).to.equal(true);
    expect(data.status).to.equal(200);
    expect(data).to.not.be.undefined;
    expect(data.data).to.not.be.undefined;
  });
  
  test("README 데이터 확인", function() {
    const data = res.getBody();
    if (data.data) {
      expect(data.data).to.have.property('readme');
    }
  });
}
