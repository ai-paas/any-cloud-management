meta {
  name: z93. release 업그레이드 (PUT)
  type: http
  seq: 93
}

put {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/helm-releases/{{release_name}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

body:json {
  {
    "chart": "{{repo_name}}/{{chart_name}}",
    "version": "{{version}}",
    "namespace": "{{namespace}}",
    "atomic": true,
    "reuseValues": true
  }
}

docs {
  release 가 없으면 400 입니다. 설치는 5번 요청을 쓰세요.

  atomic 이 true 면 실패했을 때 자동으로 되돌립니다. reuseValues 는 기존 values 를 남기고
  병합하고 resetValues 는 chart 기본값부터 다시 시작합니다. 둘 다 true 로 주면 resetValues 가
  이깁니다.
}

script:post-response {
  const id = res.getBody()?.data?.id;
  if (id) bru.setEnvVar("last_operation_id", id);
}

tests {
  test("202 + Operation", function() {
    expect(res.getStatus()).to.equal(202);
    expect(res.getBody().data).to.have.property("id");
  });
}
