meta {
  name: 7. Chart Releases (Helm 릴리즈 목록)
  type: http
  seq: 9
}

get {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/helm-releases?namespace={{namespace}}
  body: none
  auth: none
}

headers {
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  cluster_id: orb-kubernetes-001
  namespace: default
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data.success).to.equal(true);
    expect(data.status).to.equal(200);
    expect(data).to.not.be.undefined;
    expect(data.data).to.not.be.undefined;
  });
  
  test("릴리즈 목록 조회 결과 확인", function() {
    const data = res.getBody();
    if (data.data) {
      expect(data.data).to.have.property('releases');
      expect(data.data.releases).to.be.an('array');
    }
  });
}
