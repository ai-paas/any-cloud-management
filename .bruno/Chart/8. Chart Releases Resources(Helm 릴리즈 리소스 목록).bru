meta {
  name: 8. Chart Releases Resources(Helm 릴리즈 리소스 목록)
  type: http
  seq: 10
}

get {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/helm-releases/{{releasesName}}/resources?namespace={{namespace}}
  body: none
  auth: none
}

headers {
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  releasesName: nginx-test-release
  cluster_name: orb-kubernetes-001
  namespace: default
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("Response Data 확인", function() {
    const data = res.getBody();
    expect(data.success).to.equal(true);
    expect(data.status).to.equal(200);
    expect(data).to.not.be.undefined;
    expect(data.data).to.not.be.undefined;
  });
  
  test("릴리즈 리소스 조회 결과 확인", function() {
    const data = res.getBody();
    if (data.data) {
      expect(data.data).to.not.be.undefined;
    }
  });
}
