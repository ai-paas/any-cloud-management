meta {
  name: 6. Chart Status (차트 배포 상태 확인)
  type: http
  seq: 8
}

get {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/helm-releases/{{release_name}}?namespace={{namespace}}
  body: none
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  release_name: nginx-test-release
  cluster_name: orb-kubernetes-001
  namespace: default
}

tests {
  test("상태 코드 200 확인", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("배포 상태 확인", function() {
    const data = res.getBody();
    expect(data.success).to.equal(true);
    expect(data.data).to.have.property('status');
  });
}
