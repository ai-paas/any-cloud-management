meta {
  name: 2a. VM Cluster Preflight (생성 사전 검토)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/cluster-validations
  body: json
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

body:json {
  {
    "clusterProvider": "{{provision_provider}}",
    "clusterName": "{{provision_cluster_name}}",
    "description": "CSP VM 기반 Kubernetes 클러스터 사전 검토 테스트",
    "environment": "{{provision_environment}}",
    "region": "{{provision_region}}",
    "credentialId": "{{credential_id}}",
    "spec": {
      "masterInstanceType": "{{master_vm_spec}}",
      "workerInstanceType": "{{worker_vm_spec}}",
      "workerCount": "{{worker_count}}",
      "kubernetesVersion": "{{kubernetes_version}}",
      "enableIngress": "{{enable_ingress}}",
      "enableGpuOperator": "{{enable_gpu_operator}}",
      "dbEnabled": "false",
      "network": {
        "vpcCidr": "{{vpc_cidr}}",
        "podCidr": "{{pod_cidr}}",
        "serviceCidr": "{{service_cidr}}"
      }
    },
    "providerSpec": {
      "project": "{{gcp_project}}",
      "resourceGroup": "{{azure_resource_group}}",
      "imageName": "{{openstack_image_name}}",
      "flavorName": "{{openstack_flavor_name}}",
      "externalNetworkId": "{{openstack_external_network_id}}",
      "floatingIpPool": "{{openstack_floating_ip_pool}}",
      "compartmentId": "{{oci_compartment_id}}"
    }
  }
}

tests {
  test("status is 201 (검증 결과 자원)", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("links.createCluster 가 다음 단계 URL", function() {
    const body = res.getBody();
    expect(body.links).to.have.property("createCluster");
    expect(body.links.createCluster).to.equal("/v1/clusters");
  });

  test("preflight response includes readiness hints", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body).to.have.property("data");
    expect(body.data).to.have.property("readyToProvision");
    expect(body.data).to.have.property("stackName");
    expect(body.data).to.have.property("normalizedConfig");
    expect(body.data).to.have.property("appliedDefaults");
    expect(body.data).to.have.property("requiredCredentialKeys");
    expect(body.data).to.have.property("missingCredentialKeys");
    expect(body.data).to.have.property("vmOptionsDiscoveryChecked");
    expect(body.data).to.have.property("vmOptionsDiscoveryReady");
    expect(body.data).to.have.property("vmOptionsDiscoveryMessages");
    expect(body.data).to.have.property("providerReadinessChecked");
    expect(body.data).to.have.property("providerReadinessReady");
    expect(body.data).to.have.property("providerReadinessMessages");
    expect(body.data).to.have.property("e2eChecklistItems");
    expect(body.data).to.have.property("warnings");
    expect(body.data).to.have.property("errors");
    expect(body.data).to.have.property("warningItems");
    expect(body.data).to.have.property("errorItems");
  });
}
