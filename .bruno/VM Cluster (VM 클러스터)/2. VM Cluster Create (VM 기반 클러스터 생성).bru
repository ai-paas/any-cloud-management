meta {
  name: 2. VM Cluster Create (VM 기반 클러스터 생성)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/vms
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

body:json {
  {
    "vmGroupName": "{{provision_cluster_name}}",
    "provider": "{{provision_provider}}",
    "description": "CSP VM 기반 Kubernetes 클러스터 생성 테스트",
    "environment": "{{provision_environment}}",
    "region": "{{provision_region}}",
    "credentialId": "{{credential_id}}",
    "config": {
      "anycloud-k8s:masterInstanceType": "{{master_vm_spec}}",
      "anycloud-k8s:workerInstanceType": "{{worker_vm_spec}}",
      "anycloud-k8s:workerCount": "{{worker_count}}",
      "anycloud-k8s:kubernetesVersion": "{{kubernetes_version}}",
      "anycloud-k8s:vpcCidr": "{{vpc_cidr}}",
      "anycloud-k8s:podCidr": "{{pod_cidr}}",
      "anycloud-k8s:serviceCidr": "{{service_cidr}}",
      "anycloud-k8s:enableIngress": "{{enable_ingress}}",
      "anycloud-k8s:enableGpuOperator": "{{enable_gpu_operator}}",
      "anycloud-k8s:dbEnabled": "false",
      "anycloud-k8s:gcpProject": "{{gcp_project}}",
      "anycloud-k8s:azureResourceGroup": "{{azure_resource_group}}",
      "anycloud-k8s:openstackImageName": "{{openstack_image_name}}",
      "anycloud-k8s:openstackFlavorName": "{{openstack_flavor_name}}",
      "anycloud-k8s:openstackExternalNetworkId": "{{openstack_external_network_id}}",
      "anycloud-k8s:openstackFloatingIpPool": "{{openstack_floating_ip_pool}}",
      "anycloud-k8s:ociCompartmentId": "{{oci_compartment_id}}"
    }
  }
}

script:post-response {
  // Operation id 를 다음 요청에서 SSE/폴링용으로 사용 가능하게 env 에 저장.
  if (res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('last_operation_id', res.body.data.id);
  }
}

tests {
  test("상태 코드 202 확인", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("Operation 응답 확인", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body.data).to.have.property("id");
    expect(body.data.type).to.equal("CREATE_CLUSTER");
    expect(body.data.resourceType).to.equal("cluster");
  });

  test("Location 헤더 (Operation URL)", function() {
    expect(res.getHeader("Location")).to.match(/^\/v1\/operations\/op-/);
  });
}
