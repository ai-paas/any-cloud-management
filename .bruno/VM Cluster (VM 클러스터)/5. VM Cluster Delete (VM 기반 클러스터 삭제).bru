meta {
  name: 5. VM Cluster Delete (VM 기반 클러스터 삭제)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/clusters/{{provision_cluster_name}}
  body: none
  auth: none
}

tests {
  test("status is 202 (async LRO)", function() {
    expect(res.getStatus()).to.equal(202);
  });
  
  test("Operation 응답 확인", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.type).to.equal("DELETE_CLUSTER");
  });
  
  test("Location 헤더 (Operation URL)", function() {
    expect(res.getHeader("Location")).to.match(/^\/v1\/operations\/op-/);
  });
}
