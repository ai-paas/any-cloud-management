vars {
  baseUrl: http://localhost:8888
  cluster_name: gcp-kubernetes-001
  provision_cluster_name: demo-gcp-01
  provision_provider: GCP
  provision_environment: dev
  provision_region: asia-northeast3
  credential_id:
  vm_credential_id:
  vm_credential_name: gcp-manual-01
  vm_options_provider: GCP
  vm_options_region: asia-northeast3
  vm_options_keyword: ubuntu
  master_vm_spec: e2-standard-2
  worker_vm_spec: e2-standard-2
  worker_count: 2
  kubernetes_version: 1.31
  vpc_cidr: 10.52.0.0/16
  pod_cidr: 192.168.0.0/16
  service_cidr: 10.96.0.0/12
  enable_ingress: true
  enable_gpu_operator: false
  gcp_project: anycloud-dev-project
  azure_resource_group:
  openstack_image_name:
  openstack_flavor_name:
  openstack_external_network_id:
  openstack_floating_ip_pool:
  oci_compartment_id:
}
