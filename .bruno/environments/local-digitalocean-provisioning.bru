vars {
  baseUrl: http://localhost:8888
  cluster_name: digitalocean-kubernetes-001
  provision_cluster_name: demo-digitalocean-01
  provision_provider: DigitalOcean
  provision_environment: dev
  provision_region: sgp1
  credential_id:
  vm_credential_id:
  vm_credential_name: digitalocean-manual-01
  vm_options_provider: DigitalOcean
  vm_options_region: sgp1
  vm_options_keyword: ubuntu
  master_vm_spec: s-2vcpu-4gb
  worker_vm_spec: s-2vcpu-4gb
  worker_count: 2
  kubernetes_version: 1.31
  vpc_cidr: 10.88.0.0/16
  pod_cidr: 192.168.0.0/16
  service_cidr: 10.96.0.0/12
  enable_ingress: true
  enable_gpu_operator: false
  gcp_project:
  azure_resource_group:
  openstack_image_name:
  openstack_flavor_name:
  openstack_external_network_id:
  openstack_floating_ip_pool:
  oci_compartment_id:
}
