vars {
  baseUrl: http://localhost:8888
  cluster_name: oci-kubernetes-001
  provision_cluster_name: demo-oci-01
  provision_provider: OCI
  provision_environment: dev
  provision_region: ap-seoul-1
  credential_id:
  vm_credential_id:
  vm_credential_name: oci-manual-01
  vm_options_provider: OCI
  vm_options_region: ap-seoul-1
