  master_vm_spec: VM.Standard.E4.Flex
  worker_vm_spec: VM.Standard.E4.Flex
  worker_count: 2
  kubernetes_version: 1.31
  vpc_cidr: 10.86.0.0/16
  pod_cidr: 192.168.0.0/16
