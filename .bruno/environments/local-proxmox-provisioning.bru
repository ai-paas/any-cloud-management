vars {
  baseUrl: http://localhost:8888
  cluster_name: proxmox-kubernetes-001
  provision_cluster_name: demo-proxmox-01
  provision_provider: PROXMOX
  provision_environment: dev
  provision_region: pve
  credential_id: 
  vm_credential_id: 
  vm_credential_name: proxmox-manual-01
  vm_options_provider: PROXMOX
  vm_options_region: pve
  vm_options_keyword: ubuntu
  master_vm_spec: 4-8192
  worker_vm_spec: 2-4096
  worker_count: 2
  kubernetes_version: 1.31
  vpc_cidr: 10.94.0.0/24
  pod_cidr: 10.244.0.0/16
  service_cidr: 10.96.0.0/12
  enable_ingress: true
  enable_gpu_operator: false
  gcp_project: 
  azure_resource_group: 
  azure_image: Canonical:ubuntu-24_04-lts:server:latest
  openstack_image_name: 
  openstack_flavor_name: 
  openstack_external_network_id: 
  openstack_floating_ip_pool: 
  oci_compartment_id: 
  oci_image_ocid: 
  proxmox_node_name: pve
  proxmox_datastore_id: local-lvm
  proxmox_snippet_datastore_id: local
  proxmox_network_bridge: vmbr0
}
