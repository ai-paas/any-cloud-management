vars {
  baseUrl: http://localhost:8888
  cluster_name: aws-kubernetes-001
  provision_cluster_name: demo-aws-01
  provision_provider: AWS
  provision_environment: dev
  provision_region: us-east-1
  credential_id:
  vm_credential_id:
  vm_credential_name: aws-manual-01
  vm_options_provider: AWS
  vm_options_region: us-east-1
  vm_options_keyword: ubuntu
  master_vm_spec: t3.large
  worker_vm_spec: t3.large
  worker_count: 2
  kubernetes_version: 1.31
  vpc_cidr: 10.42.0.0/16
  pod_cidr: 192.168.0.0/16
  service_cidr: 10.96.0.0/12
  enable_ingress: true
  enable_gpu_operator: false
  gcp_project:
  azure_resource_group:
  openstack_image_name:
  openstack_flavor_name:
  openstack_external_network_id:
  openstack_floating_ip_pool:
  oci_compartment_id:
}
