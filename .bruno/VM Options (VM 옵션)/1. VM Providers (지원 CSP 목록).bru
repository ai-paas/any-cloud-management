meta {
  name: 1. VM Providers (지원 CSP 목록)
  type: http
  seq: 1
}

get {
  url: {{baseUrl}}/v1/providers
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("provider response includes default presets", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body).to.have.property("data");
    if (Array.isArray(body.data) && body.data.length > 0) {
      expect(body.data[0]).to.have.property("recommendedRegion");
      expect(body.data[0]).to.have.property("recommendedVmSpec");
      expect(body.data[0]).to.have.property("recommendedOsImage");
      expect(body.data[0]).to.have.property("defaultWorkerCount");
      expect(body.data[0]).to.have.property("defaultKubernetesVersion");
    }
  });
}
