meta {
  name: 3. VM Specs (VM 스펙 목록)
  type: http
  seq: 3
}

get {
  url: {{baseUrl}}/v1/providers/{{vm_options_provider}}/specs?credentialId={{vm_credential_id}}&region={{vm_options_region}}&keyword={{vm_options_keyword}}&limit=20
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("spec response can include recommendation fields", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body).to.have.property("data");
    if (Array.isArray(body.data) && body.data.length > 0) {
      expect(body.data[0]).to.have.property("recommended");
      expect(body.data[0]).to.have.property("recommendationReason");
    }
  });
}
