meta {
  name: 07. CSP 별 생성 기본값 (GET)
  type: http
  seq: 7
}

get {
  url: {{baseUrl}}/v1/providers/provisioning-defaults
  body: none
  auth: none
}

params:query {
  ~provider: {{vm_options_provider}}
  ~gpu: false
}

docs {
  CSP 별로 바로 쓸 수 있는 생성 기본값과 준비 상태를 돌려줍니다. provider 를 비우면 전체입니다.

  Proxmox 는 qemu-guest-agent 가 없어 IP 를 역질의할 수 없습니다. nodeIps, gateway, sshHost,
  sshPorts 가 채워져 있지 않으면 일괄 생성이 노드마다 주소를 물어봅니다.
}

tests {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("provider 별 ready 상태를 돌려준다", function() {
    const items = res.getBody().data.items || res.getBody().data;
    expect(items).to.be.an("array").that.is.not.empty;
  });
}
