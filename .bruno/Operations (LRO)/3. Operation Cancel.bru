meta {
  name: 3. Operation Cancel
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/operations/{{last_operation_id}}/cancel
  body: none
  auth: none
}

headers {
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

docs {
  RUNNING/PENDING 상태의 Operation 만 취소 가능. SUCCEEDED/FAILED/CANCELLED 는 409.
  취소는 best-effort — 이미 외부 시스템 (CSP/Helm) 으로 invoke 된 작업은 rollback 책임 클라이언트.

  last_operation_id 는 1. Operations Search 의 post-response 가 자동 seed (RUNNING 우선,
  없으면 가장 최근 op). 단독 실행 시 RUNNING op 가 없으면 cancel 은 409 가 정상.
}

tests {
  test("status 202", function() {
    expect(res.getStatus()).to.equal(202);
  });

  test("CANCELLED 전환 확인", function() {
    const body = res.getBody();
    expect(body.data.state).to.equal("CANCELLED");
  });
}
