meta {
  name: 2. Operation Get
  type: http
  seq: 2
}

get {
  url: {{baseUrl}}/v1/operations/{{last_operation_id}}
  body: none
  auth: none
}

headers {
  User-Agent: bruno/3.3.0
}

docs {
  last_operation_id 는 collection 첫 step (1. Operations Search) 의 post-response 가 자동
  seed 합니다 — RUNNING op 가 있으면 그 id, 없으면 가장 최근 op 로 fallback. 또한 LRO 시작
  endpoint (Cluster Create / Helm Deploy / Uninstall / Scale / Upgrade) 의 post-response 도
  같은 env var 에 저장 → Operation 컬렉션을 단독 실행하지 않을 때도 chain.

  단독 실행 시 DB 에 op 가 0건이면 1. Search 가 seed 못 함 → environment 파일에 수동 hardcode.
}

tests {
  test("status 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("Operation 자원 schema", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data).to.have.property("type");
    expect(body.data).to.have.property("state");
    expect(body.data).to.have.property("resourceType");
    expect(body.data).to.have.property("resourceId");
  });
}
