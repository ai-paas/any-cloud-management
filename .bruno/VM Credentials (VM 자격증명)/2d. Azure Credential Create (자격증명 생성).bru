meta {
  name: 2d. Azure Credential Create (자격증명 생성)
  type: http
  seq: 6
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "Azure",
    "name": "azure-manual-01",
    "description": "Azure service principal credential (registered {{$isoTimestamp}})",
    "credentials": {
      "ARM_CLIENT_ID": "00000000-0000-0000-0000-000000000000",
      "ARM_CLIENT_SECRET": "your-client-secret",
      "ARM_SUBSCRIPTION_ID": "00000000-0000-0000-0000-000000000000",
      "ARM_TENANT_ID": "00000000-0000-0000-0000-000000000000"
    }
  }
}

docs {
  Azure credential 등록 — service principal 기반.

  필수 키 (ProvisioningCredentialRules) :
    - ARM_CLIENT_ID         : SP application (client) ID
    - ARM_CLIENT_SECRET     : SP secret
    - ARM_SUBSCRIPTION_ID   : 대상 subscription
    - ARM_TENANT_ID         : Azure AD tenant

  발급 :
    az ad sp create-for-rbac --name <name> --role Contributor \
      --scopes /subscriptions/<sub-id>

  최소 권한 :
    Contributor (subscription 또는 resource group 단위)
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("Azure");
  });
}
