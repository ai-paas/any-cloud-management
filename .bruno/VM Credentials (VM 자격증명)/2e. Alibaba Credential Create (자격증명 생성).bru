meta {
  name: 2e. Alibaba Credential Create (자격증명 생성)
  type: http
  seq: 7
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "Alibaba",
    "name": "alibaba-manual-01",
    "description": "Alibaba Cloud RAM access key credential (registered {{$isoTimestamp}})",
    "credentials": {
      "ALICLOUD_ACCESS_KEY": "LTAI4xxxxxxxxxxxxxxxxx",
      "ALICLOUD_SECRET_KEY": "your-secret-key"
    }
  }
}

docs {
  Alibaba Cloud credential 등록 — RAM access key 기반.

  필수 키 (ProvisioningCredentialRules) :
    - ALICLOUD_ACCESS_KEY
    - ALICLOUD_SECRET_KEY

  발급 :
    RAM 콘솔 → User → AccessKey 생성

  최소 권한 :
    AliyunECSFullAccess, AliyunVPCFullAccess
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("Alibaba");
  });
}
