meta {
  name: 2a. VM Credential Create From Process Env (환경변수 기반 생성)
  type: http
  seq: 3
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

body:json {
  {
    "provider": "{{provision_provider}}",
    "name": "{{vm_credential_name}}",
    "description": "Process env backed credential for VM cluster provisioning",
    "credentials": {{process.env.VM_CREDENTIALS_JSON}}
  }
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });

  test("process env credential create uses success envelope", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body).to.have.property("data");
  });
}
