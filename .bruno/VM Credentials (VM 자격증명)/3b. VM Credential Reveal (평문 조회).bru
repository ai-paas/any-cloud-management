meta {
  name: 3b. VM Credential Reveal (평문 조회)
  type: http
  seq: 15
}

get {
  url: {{baseUrl}}/v1/credentials/{{vm_credential_id}}/reveal
  body: none
  auth: none
}

docs {
  복호화한 자격증명을 돌려주는 유일한 경로입니다. 목록이나 상세 응답에는 값이 섞이지 않습니다.
  응답이 캐시나 로그에 남지 않도록 주의하세요.
}

tests {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
