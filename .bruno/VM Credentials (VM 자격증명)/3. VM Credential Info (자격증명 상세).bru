meta {
  name: 3. VM Credential Info (자격증명 상세)
  type: http
  seq: 13
}

get {
  url: {{baseUrl}}/v1/credentials/{{vm_credential_id}}
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("credential detail uses success envelope", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body).to.have.property("data");
  });
}
