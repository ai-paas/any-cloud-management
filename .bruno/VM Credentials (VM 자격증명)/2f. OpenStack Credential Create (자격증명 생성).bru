meta {
  name: 2f. OpenStack Credential Create (자격증명 생성)
  type: http
  seq: 8
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "OpenStack",
    "name": "openstack-manual-01",
    "description": "OpenStack Keystone credential (registered {{$isoTimestamp}})",
    "sourceType": "MANUAL",
    "credentials": {
      "OS_AUTH_URL": "https://keystone.example.com:5000/v3",
      "OS_USERNAME": "admin",
      "OS_PASSWORD": "your-password",
      "OS_PROJECT_NAME": "admin",
      "OS_USER_DOMAIN_NAME": "Default",
      "OS_PROJECT_DOMAIN_NAME": "Default"
    }
  }
}

docs {
  OpenStack credential 등록 — Keystone 인증 기반.

  필수 키 (ProvisioningCredentialRules) :
    - OS_AUTH_URL       : Keystone endpoint (v3 권장)
    - OS_USERNAME
    - OS_PASSWORD
    - OS_PROJECT_NAME

  선택 키 :
    - OS_USER_DOMAIN_NAME      (default "Default")
    - OS_PROJECT_DOMAIN_NAME   (default "Default")
    - OS_INTERFACE             (public / internal / admin)
    - OS_IDENTITY_API_VERSION  (3)

  rc 파일 import :
    source ~/Downloads/admin-openrc.sh
    그 후 env 값 그대로 복사
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("OpenStack");
  });
}
