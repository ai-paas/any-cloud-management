meta {
  name: 2b. AWS Credential Create (자격증명 생성)
  type: http
  seq: 4
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "AWS",
    "name": "aws-manual-01",
    "description": "AWS IAM access key credential (registered {{$isoTimestamp}})",
    "sourceType": "MANUAL",
    "credentials": {
      "AWS_ACCESS_KEY_ID": "AKIAIOSFODNN7EXAMPLE",
      "AWS_SECRET_ACCESS_KEY": "wJalrXUtnFEMI/K7MDENG/bPxRfiCYEXAMPLEKEY"
    }
  }
}

script:post-response {
  // 등록 성공 시 credential id 를 환경변수에 promotion — 다음 .bru 들이 즉시 사용 가능.
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("AWS");
    expect(body.data.sourceType).to.equal("MANUAL");
  });
}

docs {
  AWS credential 등록 — IAM access key 기반.
  
  필수 키 (ProvisioningCredentialRules) :
    - AWS_ACCESS_KEY_ID
    - AWS_SECRET_ACCESS_KEY
  
  발급 :
    aws iam create-access-key --user-name <user>
  
  최소 권한 (provisioning 용) :
    EC2FullAccess, VPCFullAccess, IAMReadOnly
}
