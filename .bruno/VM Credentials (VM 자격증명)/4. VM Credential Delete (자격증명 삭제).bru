meta {
  name: 4. VM Credential Delete (자격증명 삭제)
  type: http
  seq: 14
}

delete {
  url: {{baseUrl}}/v1/credentials/{{credential_id}}
  body: none
  auth: none
}

tests {
  test("status is 200", function() {
    expect(res.getStatus()).to.equal(200);
  });
  
  test("credential delete uses success envelope", function() {
    const body = res.getBody();
    expect(body).to.have.property("data");
    expect(body.data.operation).to.equal("delete");
  });
}
