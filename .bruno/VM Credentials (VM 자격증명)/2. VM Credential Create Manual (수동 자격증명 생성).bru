meta {
  name: 2. VM Credential Create Manual (수동 자격증명 생성)
  type: http
  seq: 2
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

body:json {
  {
    "provider": "{{provision_provider}}",
    "name": "{{vm_credential_name}}",
    "description": "Manual credential for VM cluster provisioning",
    "sourceType": "MANUAL",
    "credentials": {
      "{{?Credential Key 1}}": "{{?Credential Value 1}}",
      "{{?Credential Key 2}}": "{{?Credential Value 2}}"
    }
  }
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  
  test("credential create uses success envelope", function() {
    const body = res.getBody();
    expect(body).to.have.property("success");
    expect(body).to.have.property("data");
  });
}
