meta {
  name: 2i. DigitalOcean Credential Create (자격증명 생성)
  type: http
  seq: 11
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "DigitalOcean",
    "name": "digitalocean-manual-01",
    "description": "DigitalOcean Personal Access Token (registered {{$isoTimestamp}})",
    "credentials": {
      "DIGITALOCEAN_TOKEN": "dop_v1_xxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxxx"
    }
  }
}

docs {
  DigitalOcean credential 등록 — Personal Access Token 기반.

  필수 키 (ProvisioningCredentialRules) — 둘 중 하나 :
    - DIGITALOCEAN_TOKEN
    - DIGITALOCEAN_ACCESS_TOKEN   (alias, 둘 중 하나만 있으면 OK)

  발급 :
    DO Console → API → Tokens/Keys → Generate New Token
    (Write 권한 필수)
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("DigitalOcean");
  });
}
