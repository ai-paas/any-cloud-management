meta {
  name: 12. VM Credential Health Refresh (재확인)
  type: http
  seq: 12
}

post {
  url: {{baseUrl}}/v1/credentials/{{vm_credential_id}}/health/refresh
  body: none
  auth: none
}

headers {
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

docs {
  저장된 확인 결과를 버리고 CSP 에 다시 물어봅니다. 3a 는 저장된 결과를 읽습니다.

  Proxmox 처럼 리전 개념이 없는 provider 는 리전 개수가 0 입니다. 확인한 것은 토큰이 통한다는
  사실이지 리전 목록이 아닙니다.
}

tests {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });

  test("확인 시각이 갱신된다", function() {
    expect(res.getBody().data).to.have.property("checkedAt");
  });
}
