meta {
  name: 3a. VM Credential Health (가용성 확인)
  type: http
  seq: 14
}

post {
  url: {{baseUrl}}/v1/credentials/{{vm_credential_id}}/health
  body: none
  auth: none
}

docs {
  CSP API 를 실제로 호출해 자격증명이 쓸 수 있는지 확인한다. 비밀값은 내려오지 않는다.

  리전이 있는 프로바이더는 조회한 리전 수가 함께 온다. Proxmox 는 리전이 없어 0 이고,
  확인한 것은 토큰이 통한다는 사실이다.
}

tests {
  test("status is 200", function() {
    // 결과가 실패여도 확인 자체는 성공한 호출이다. 200 이 아니면 배지 대신 오류 화면이 뜬다.
    expect(res.getStatus()).to.equal(200);
  });

  test("확인 결과가 내려온다", function() {
    const data = res.getBody().data;
    expect(data).to.have.property("healthy");
    expect(data).to.have.property("checkedAt");
  });

  test("정상이면 원인 분류가 비어 있다", function() {
    const data = res.getBody().data;
    if (data.healthy) {
      expect(data.kind).to.be.null;
    } else {
      // 실패했으면 사용자가 할 일을 알려줘야 한다.
      expect(data.kind).to.be.a("string");
      expect(data.hint).to.be.a("string");
    }
  });

  test("리전이 있는 프로바이더는 조회 수가 남는다", function() {
    const data = res.getBody().data;
    const provider = bru.getEnvVar("vm_options_provider") || "";
    if (data.healthy && provider.toLowerCase() !== "proxmox") {
      expect(data.checkedRegions).to.be.above(0);
    }
  });
}
