meta {
  name: 2h. OCI Credential Create (자격증명 생성)
  type: http
  seq: 10
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "OCI",
    "name": "oci-manual-01",
    "description": "OCI API signing key credential (registered {{$isoTimestamp}})",
    "sourceType": "MANUAL",
    "credentials": {
      "TF_VAR_tenancy_ocid": "ocid1.tenancy.oc1..exampleuniqueID",
      "TF_VAR_user_ocid": "ocid1.user.oc1..exampleuniqueID",
      "TF_VAR_fingerprint": "aa:bb:cc:dd:ee:ff:00:11:22:33:44:55:66:77:88:99",
      "TF_VAR_region": "ap-seoul-1",
      "TF_VAR_private_key": "-----BEGIN RSA PRIVATE KEY-----\nMIIEvQIBADANBgkqhkiG9w0BAQEFAASCBKcwggSjAgEAAoIBAQ...\n-----END RSA PRIVATE KEY-----"
    }
  }
}

docs {
  OCI credential 등록 — API signing key 기반.

  필수 키 (ProvisioningCredentialRules) :
    - TF_VAR_tenancy_ocid
    - TF_VAR_user_ocid
    - TF_VAR_fingerprint
    - TF_VAR_region
    - 다음 중 하나 :
        TF_VAR_private_key       : private key PEM 을 string 으로 inline
        TF_VAR_private_key_path  : key 파일 절대 경로

  발급 :
    OCI Console → User Settings → API Keys → Add API Key
    → private key (PEM) 다운로드 + fingerprint 메모

  최소 권한 :
    Compute Instance Family / VNICs / Volumes 정책 (compartment 단위 권장)
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("OCI");
  });
}
