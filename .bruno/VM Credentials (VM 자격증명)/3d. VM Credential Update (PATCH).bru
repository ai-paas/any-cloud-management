meta {
  name: 3d. VM Credential Update (PATCH)
  type: http
  seq: 17
}

patch {
  url: {{baseUrl}}/v1/credentials/{{vm_credential_id}}
  body: json
  auth: none
}

headers {
  content-type: application/json
  Idempotency-Key: {{$randomUUID}}
  User-Agent: bruno/3.3.0
}

body:json {
  {
    "description": "bruno 에서 갱신"
  }
}

docs {
  null 로 둔 필드는 그대로 둡니다. 무엇을 무엇으로 바꿨는지는 감사 로그에 남기지 않습니다.
  남기면 감사 로그가 비밀 저장소가 됩니다.
}

tests {
  test("200", function() {
    expect(res.getStatus()).to.equal(200);
  });
}
