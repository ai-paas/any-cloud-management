meta {
  name: 2c. GCP Credential Create (자격증명 생성)
  type: http
  seq: 5
}

post {
  url: {{baseUrl}}/v1/credentials
  body: json
  auth: none
}

headers {
  content-type: application/json
}

body:json {
  {
    "provider": "GCP",
    "name": "gcp-manual-01",
    "description": "GCP service account JSON credential (registered {{$isoTimestamp}})",
    "sourceType": "MANUAL",
    "credentials": {
      "GOOGLE_CREDENTIALS": "{\"type\":\"service_account\",\"project_id\":\"my-project\",\"private_key_id\":\"...\",\"private_key\":\"-----BEGIN PRIVATE KEY-----\\n...\\n-----END PRIVATE KEY-----\\n\",\"client_email\":\"sa@my-project.iam.gserviceaccount.com\",\"client_id\":\"...\"}"
    }
  }
}

docs {
  GCP credential 등록 — service account JSON 기반.

  필수 키 (ProvisioningCredentialRules) — 둘 중 하나 :
    - GOOGLE_CREDENTIALS               : service account JSON 을 string 으로 inline
    - GOOGLE_APPLICATION_CREDENTIALS   : JSON 파일 경로 (절대 path)

  발급 :
    gcloud iam service-accounts keys create key.json \
      --iam-account=<sa>@<project>.iam.gserviceaccount.com

  최소 권한 :
    roles/compute.admin, roles/iam.serviceAccountUser
}

script:post-response {
  if (res && res.body && res.body.data && res.body.data.id) {
    bru.setEnvVar('vm_credential_id', res.body.data.id);
  }
}

tests {
  test("status is 201", function() {
    expect(res.getStatus()).to.equal(201);
  });
  test("body 에 credential id 가 포함", function() {
    const body = res.getBody();
    expect(body.data).to.have.property("id");
    expect(body.data.provider).to.equal("GCP");
  });
}
