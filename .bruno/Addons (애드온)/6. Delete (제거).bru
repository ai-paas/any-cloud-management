meta {
  name: 6. Delete (제거)
  type: http
  seq: 6
}

delete {
  url: {{baseUrl}}/v1/clusters/{{cluster_name}}/addons/{{addon_id}}
  body: none
  auth: none
}

headers {
  content-type: application/json
  User-Agent: bruno/3.3.0
}

vars:pre-request {
  cluster_name: orb-kubernetes-001
  addon_id: addon-xxxxx
}

tests {
  test("상태 코드 202", function() {
    expect(res.getStatus()).to.equal(202);
  });
}

docs {
  Addon 제거 — DELETING state + uninstall queue. listener 가 helm uninstall 완료 후 DELETED.
  row 는 soft delete (operation 이력 보존).

  helm release 이미 없는 경우에도 멱등 — agent 가 NotFound 로 처리.
}
