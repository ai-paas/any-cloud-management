# syntax=docker/dockerfile:1.7
#
# anycloud backend with Pulumi Java Automation API.

# 플러그인 목록. 스테이지를 넘지 않으므로 전역에 두고 각 스테이지가 상속한다.
# PluginVersions.DEFAULT 와 같은 값이어야 한다 — 어긋나면 런타임에 다시 받는다.
# 목록을 좁히면 그만큼 이미지가 준다. openstack 전용이면 "openstack:5.5.1 tls:5.6.0".
ARG PULUMI_PLUGINS="aws:7.44.0 gcp:9.36.1 azure-native:3.27.0 oci:4.22.0 openstack:5.5.1 proxmoxve:8.6.0 tls:5.6.0"

# Gradle (Java) build stage.
FROM eclipse-temurin:21-jdk AS gradle-builder

WORKDIR /app

COPY gradlew gradlew.bat ./
COPY gradle/ gradle/
COPY build.gradle settings.gradle ./
COPY apps/anycloud/ apps/anycloud/
COPY libs/cluster-agent-spring-boot-starter/ libs/cluster-agent-spring-boot-starter/
COPY libs/cluster-agent-features-spring-boot-starter/ libs/cluster-agent-features-spring-boot-starter/
COPY libs/cluster-provisioning-spring-boot-starter/ libs/cluster-provisioning-spring-boot-starter/
# apps/anycloud/build.gradle 의 copyAgentChartResources task 가 helm chart 를 classpath 로
# 번들. 누락 시 AgentChartRenderer 가 런타임 classpath:agent-chart/ 못 찾고 init fail.
COPY apps/agent/deploy/helm/ apps/agent/deploy/helm/

RUN chmod +x ./gradlew

# Gradle wrapper 부트스트랩은 services.gradle.org 네트워크 의존 — slow link 환경 보호.
# /root/.gradle BuildKit cache mount 로 wrapper dist + dependency cache 보존.
RUN --mount=type=cache,target=/root/.gradle \
    for i in 1 2 3; do \
        ./gradlew --version --no-daemon && break || \
        { echo "gradle wrapper bootstrap failed (attempt $i/3), retry in 10s..."; sleep 10; }; \
    done && \
    ./gradlew bootJar --no-daemon

# 레이어 분리. 의존성(168MB)과 애플리케이션(20MB)이 갈려 코드만 바뀐 빌드는 20MB 레이어만 새로 만든다.
RUN java -Djarmode=tools -jar apps/anycloud/build/libs/*-SNAPSHOT.jar \
        extract --layers --destination /app/extracted


# CLI 스테이지 — pulumi, helm 바이너리만 받는다.
FROM alpine:3.20 AS cli-fetch

ARG PULUMI_VERSION=3.261.0
ARG HELM_VERSION=3.19.0
ARG TARGETARCH

# gcompat — package add 가 OpenTofu provider 를 실행해 스키마를 뽑는다. 그 바이너리는
# glibc 를 동적 링크한다.
RUN apk add --no-cache curl tar gcompat libc6-compat

# Pulumi / Helm release archive 는 arch 별로 분기. TARGETARCH (amd64|arm64) → release naming.
RUN case "${TARGETARCH}" in \
        amd64) PULUMI_ARCH=x64 ;; \
        arm64) PULUMI_ARCH=arm64 ;; \
        *) echo "Unsupported TARGETARCH=${TARGETARCH}" >&2; exit 1 ;; \
    esac \
    && curl -fsSL "https://get.pulumi.com/releases/sdk/pulumi-v${PULUMI_VERSION}-linux-${PULUMI_ARCH}.tar.gz" -o /tmp/pulumi.tar.gz \
    && tar -xzf /tmp/pulumi.tar.gz -C /opt \
    && rm -f /tmp/pulumi.tar.gz \
    # 프로그램은 전부 runtime: yaml 이다. 나머지 language host 는 140MB 를 차지하고 쓰이지 않는다.
    && rm -f /opt/pulumi/pulumi-language-go \
             /opt/pulumi/pulumi-language-java \
             /opt/pulumi/pulumi-language-dotnet \
             /opt/pulumi/pulumi-language-nodejs \
             /opt/pulumi/pulumi-language-python \
             /opt/pulumi/pulumi-language-python-exec \
             /opt/pulumi/pulumi-resource-pulumi-nodejs \
             /opt/pulumi/pulumi-resource-pulumi-python \
             /opt/pulumi/pulumi-analyzer-policy-python \
             /opt/pulumi/pulumi-watch

RUN curl -fsSL "https://get.helm.sh/helm-v${HELM_VERSION}-linux-${TARGETARCH}.tar.gz" -o /tmp/helm.tar.gz \
    && tar -xzf /tmp/helm.tar.gz -C /tmp \
    && mv "/tmp/linux-${TARGETARCH}/helm" /opt/helm \
    && chmod +x /opt/helm


# 플러그인 스테이지 — 1.8GB 다운로드를 apk 목록이나 앱 코드 변경과 분리해 캐시한다.
FROM cli-fetch AS plugin-fetch

ARG PULUMI_PLUGINS

# 서드파티 플러그인은 get.pulumi.com 에 없고 GitHub 릴리스에서 받는다. 익명 요청은 IP 당
# 시간당 60회라 CI 에서 쉽게 걸린다 — GITHUB_TOKEN 을 secret 으로 넘기면 5000회가 된다.
ARG PULUMI_PLUGIN_SERVERS="proxmoxve=github://api.github.com/muhlba91/pulumi-proxmoxve"

# Pulumi 는 $PULUMI_HOME/plugins 만 본다. PULUMI_PLUGIN_CACHE_DIR 은 인식하지 않고
# 심볼릭 링크도 따라가지 않는다 — 다른 경로에 두면 런타임에 전부 다시 받는다.
RUN --mount=type=secret,id=github_token,required=false \
    if [ -f /run/secrets/github_token ]; then \
        GITHUB_TOKEN="$(cat /run/secrets/github_token)"; export GITHUB_TOKEN; \
    fi; \
    for p in ${PULUMI_PLUGINS}; do \
        name="${p%%:*}"; ver="${p##*:}"; server=""; \
        for m in ${PULUMI_PLUGIN_SERVERS}; do \
            [ "${m%%=*}" = "$name" ] && server="--server ${m#*=}"; \
        done; \
        PULUMI_HOME=/plugin-home /opt/pulumi/pulumi plugin install \
            resource "$name" "v$ver" $server || exit 1; \
    done

# IBM 은 사전 컴파일된 플러그인이 없다. terraform-provider 베이스가 OpenTofu provider 를 런타임에
# 붙이는 구조라, 프로그램 옆에 스키마 파일이 있어야 타입이 해석된다. 여기서 한 번 만들어 둔다.
ARG IBM_PACKAGE="ibm-cloud/ibm"
RUN mkdir -p /packages && cd /packages \
    && printf 'name: seed\nruntime: yaml\nresources: {}\n' > Pulumi.yaml \
    && PULUMI_HOME=/plugin-home /opt/pulumi/pulumi package add terraform-provider "${IBM_PACKAGE}" \
    && rm -f Pulumi.yaml


# Runtime stage.
FROM eclipse-temurin:21-jre-alpine

# gcompat — IBM 처럼 terraform-provider 로 브리지되는 provider 는 OpenTofu 레지스트리의
# 바이너리를 그대로 실행한다. 그것들은 정적 Go 빌드가 아니라 glibc 를 동적 링크해서
# musl 만으로는 "Dynamic loader not found" 로 죽는다.
RUN apk add --no-cache \
       bash \
       ca-certificates \
       curl \
       gcompat \
       git \
       libc6-compat \
       openssh-client \
       tar \
       unzip

COPY --from=cli-fetch /opt/pulumi/ /opt/pulumi/
COPY --from=cli-fetch /opt/helm /usr/local/bin/helm
RUN ln -s /opt/pulumi/pulumi /usr/local/bin/pulumi

# uid, gid 를 고정한다. Debian 의 useradd -r 이 쓰던 999 와 맞춰야 기존 배포의 named volume
# (PULUMI_HOME) 을 그대로 읽는다. 번호가 바뀌면 볼륨이 통째로 접근 불가가 된다.
# uid 를 고정한다. Debian 의 useradd -r 이 쓰던 999 와 맞춰야 기존 배포의 named volume
# (PULUMI_HOME, 모드 700) 을 그대로 읽는다. 번호가 바뀌면 볼륨이 통째로 접근 불가가 된다.
# gid 999 는 Alpine 의 ping 그룹이 이미 쓰므로 그룹 번호는 고정하지 않는다.
RUN addgroup -S anycloud \
    && adduser -S -u 999 -G anycloud -h /home/anycloud anycloud

# --chown 으로 복사해야 한다. 뒤에서 chown -R 하면 1.8GB 를 복제한 레이어가 생긴다.
COPY --from=plugin-fetch --chown=anycloud:anycloud /plugin-home/plugins/ /app/.pulumi/plugins/
# terraform-provider 가 런타임에 받는 OpenTofu 바이너리도 캐시한다.
COPY --from=plugin-fetch --chown=anycloud:anycloud /plugin-home/dynamic_tf_plugins/ /app/.pulumi/dynamic_tf_plugins/
COPY --from=plugin-fetch --chown=anycloud:anycloud /packages/sdks/ /opt/pulumi-packages/sdks/

WORKDIR /app

# 변경 빈도가 낮은 순서대로 COPY 한다 — 위쪽 레이어가 캐시에 남아야 재빌드가 빠르다.
COPY --from=gradle-builder --chown=anycloud:anycloud /app/extracted/dependencies/ ./
COPY --from=gradle-builder --chown=anycloud:anycloud /app/extracted/spring-boot-loader/ ./
COPY --from=gradle-builder --chown=anycloud:anycloud /app/extracted/snapshot-dependencies/ ./
COPY --from=gradle-builder --chown=anycloud:anycloud /app/extracted/application/ ./
COPY --chown=anycloud:anycloud --chmod=755 infra/docker/entrypoints/anycloud-entrypoint.sh /app/entrypoint.sh

# 소유권은 COPY --chown 으로 이미 잡혔다. 여기서 chown -R 하면 lib 176MB 를 복제한
# 레이어가 하나 더 생긴다.
RUN mkdir -p /app/.cache /app/.config /app/.local/share /app/runtime \
    && chown anycloud:anycloud \
       /app /app/.cache /app/.config /app/.local/share /app/runtime \
    && chmod 755 /app

ENV PATH="/opt/pulumi:${PATH}"
ENV HOME="/home/anycloud"
ENV XDG_CACHE_HOME=/app/.cache
ENV XDG_CONFIG_HOME=/app/.config
ENV XDG_DATA_HOME=/app/.local/share
ENV PULUMI_HOME=/app/.pulumi
# 앱이 YAML 리소스에 options.version 으로 박는다. 설치본과 같은 값이어야 한다.
ARG PULUMI_PLUGINS
ENV PULUMI_PLUGINS="${PULUMI_PLUGINS}"
ENV JAVA_OPTS="-XX:+UseContainerSupport -XX:MaxRAMPercentage=75.0 -XX:+UseG1GC -XX:+UseStringDeduplication"

USER anycloud

EXPOSE 8888

ENTRYPOINT ["/app/entrypoint.sh"]
