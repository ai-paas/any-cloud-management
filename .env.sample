# anycloud — .env 로 복사해 채운다.
#
# 3-tier 환경변수 정책:
#   1. Dockerfile.pulumi 의 ENV    — container path 고정값 (PULUMI_PROJECT_DIR 등)
#   2. config/*.yaml 의 default    — 코드 로직의 합리적 기본값 (stack-prefix=anycloud 등)
#   3. docker-compose.yml          — 서비스 간 wiring + 본 파일의 secret 게이트
#
# 본 파일에는 secret 과 환경별 값만 둔다. 나머지는 yaml/Dockerfile 의 default 를 쓴다.
#
# 값 뒤에 주석을 붙이지 않는다. `docker-compose` v1 은 인라인 주석을 값에 포함시킨다.
# 기동은 v2 (`docker compose`) 로 한다.

# ---------------------------------------------------------------------------
# Required secrets (8) — 비우면 기동이 fail-fast 로 멈춘다
# ---------------------------------------------------------------------------

# openssl rand -hex 24
DB_PASS=
DB_ROOT_PASS=
RABBITMQ_PASS=

# openssl rand -hex 32
RUSTFS_ROOT_PASSWORD=
PULUMI_PASSPHRASE=
ANYCLOUD_AGENT_JWT_SECRET=

# openssl rand -hex 16
OPENBAO_DEV_ROOT_TOKEN=

# CSP credential 암호화 (MANUAL credential 사용 시 필수). openssl rand -hex 32
# 부팅 시 검증: 32자 미만 거부, 알려진 sentinel ("change-me" 등) 거부.
CSP_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Deployment-specific (2) — 환경마다 다른 값, default 없음
# ---------------------------------------------------------------------------

# 원격 K8s cluster 의 agent pod 가 backend 로 outbound 접속할 endpoint (host:port).
#   운영     : ingress / LB / NodePort 의 public DNS (예: agent.aipaas.example.com:9090)
#   dev      : cloudflared / ngrok / tailscale public host
#   같은 LAN : 노트북 IP (예: 192.168.0.42:9090)
# localhost / host.docker.internal 은 원격 cluster 에서 NXDOMAIN — 동작 안 함.
ANYCLOUD_AGENT_GRPC_PUBLIC_ENDPOINT=host.docker.internal:9090

# Cluster 등록 응답 (BootstrapInfo.kubectlApplyCommand) 의 curl base URL.
# 사용자가 kubectl context 에서 실행할 명령에 박혀 나가므로 외부에서 도달 가능해야 한다.
#   운영        : backend 의 /v1/clusters/{c}/agent-manifest.yaml 을 외부 노출하는
#                 reverse-proxy / gateway URL (예: https://api.aipaas.example.com)
#   단일 컨테이너 : backend 직접 접근 URL (예: http://anycloud.example.com:8888)
#   비워두면     : 현재 HTTP 요청의 host 자동 사용 (X-Forwarded-* 반영), 최종 fallback 은
#                 http://localhost:8888
ANYCLOUD_PUBLIC_URL=

# ---------------------------------------------------------------------------
# Optional — default 가 compose 또는 config/*.yaml 에 있다
# ---------------------------------------------------------------------------

# DB_USER=anycloud
# RABBITMQ_USER=anycloud
# RUSTFS_ROOT_USER=anycloud
# RUSTFS_REGION=us-east-1
# PULUMI_SECRETS_PROVIDER=passphrase

# 이미지. 운영에서는 tag 를 pin 하는 쪽이 안전하다 — latest 는 다음 release 로 조용히 바뀐다.
# ANYCLOUD_AGENT_IMAGE=ghcr.io/ai-paas/cluster-agent:v0.1.3-dev
# ANYCLOUD_BACKEND_IMAGE=ghcr.io/ai-paas/anycloud-backend
# ANYCLOUD_BACKEND_IMAGE_TAG=v0.0.1

# 사용자가 직접 helm install 로 cluster-agent 를 배포할 때 (HELM_BOOTSTRAP / MANUAL) 등록
# 응답의 `helm repo add` 안내에 들어갈 chart repository URL. 운영자 셸에서 도달 가능해야 한다.
# 자동 설치 (API_MANAGED, default) 는 jar 에 packaged 된 chart 를 쓰므로 비워도 된다.
# 현재 chart 를 publish 하는 workflow 가 없어 가리킬 대상이 없다.
# ANYCLOUD_AGENT_HELM_REPO_URL=

# ---------------------------------------------------------------------------
# 주의 — 아래는 compose 가 backend 컨테이너로 전달하지 않는다.
# 여기에 적어도 적용되지 않으며, docker-compose.yml 의 environment 블록에
# 추가해야 동작한다.
# ---------------------------------------------------------------------------
#   ANYCLOUD_CORS_ALLOWED_ORIGINS   운영에서 정확한 origin 명시 (콤마 구분)
#   SECURITY_AUTH_ENABLED           default false (static bearer token mode)
#   SECURITY_AUTH_TOKEN
