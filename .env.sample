# anycloud — required environment variables (copy to .env and fill).
#
# 3-tier 환경변수 정책:
#   1. Dockerfile.pulumi 의 ENV    — container path 고정값 (PULUMI_PROJECT_DIR 등)
#   2. config/*.yaml 의 default    — 코드 로직의 합리적 기본값 (stack-prefix=anycloud 등)
#   3. docker-compose.yml          — 서비스 간 wiring + 본 파일의 secret 게이트
#
# 본 파일에는 secret 만 보관. 비-secret 변수는 yaml/Dockerfile 의 default 사용.
#
# Generate strong random secrets:
#   openssl rand -hex 32

# ---------------------------------------------------------------------------
# Required secrets (8개)
# ---------------------------------------------------------------------------

# Database
DB_PASS=                       # openssl rand -hex 24
DB_ROOT_PASS=                  # openssl rand -hex 24

# RabbitMQ
RABBITMQ_PASS=                 # openssl rand -hex 24

# RustFS (Pulumi state backend, S3-compatible)
RUSTFS_ROOT_PASSWORD=          # openssl rand -hex 32

# OpenBao (Pulumi secrets provider — dev mode)
OPENBAO_DEV_ROOT_TOKEN=        # openssl rand -hex 16

# Pulumi state encryption
PULUMI_PASSPHRASE=             # openssl rand -hex 32

# CSP credential 암호화 (MANUAL credential 사용 시 필수)
# 부팅 시 fail-fast 검증: <32 chars 거부, 알려진 sentinel ("change-me" 등) 거부.
CSP_CREDENTIAL_ENCRYPTION_KEY= # openssl rand -hex 32

# Cluster agent JWT signing
ANYCLOUD_AGENT_JWT_SECRET=     # openssl rand -hex 32

# ---------------------------------------------------------------------------
# Deployment-specific (2개) — 환경마다 다른 값, default 없음
# ---------------------------------------------------------------------------

# 원격 K8s cluster 안 agent pod 가 backend 로 outbound 접속할 endpoint (host:port).
#   - 운영     : ingress / LB / NodePort 의 public DNS (예: agent.aipaas.example.com:9090)
#   - dev      : cloudflared / ngrok / tailscale public host
#   - 같은 LAN : 노트북 IP (예: 192.168.0.42:9090)
# localhost / host.docker.internal 은 원격 cluster 에서 NXDOMAIN — 동작 안 함.
ANYCLOUD_AGENT_GRPC_PUBLIC_ENDPOINT=host.docker.internal:9090

# Helm chart repository — backend 가 cluster-agent chart pull 시 사용.
# Production: ChartMuseum / OCI registry / GitHub releases URL.
ANYCLOUD_AGENT_HELM_REPO_URL=

# ---------------------------------------------------------------------------
# Optional overrides (default 가 compose 또는 yaml 에 있음)
# ---------------------------------------------------------------------------

# DB_USER=anycloud                                # default: anycloud
# RABBITMQ_USER=anycloud                          # default: anycloud
# RUSTFS_ROOT_USER=anycloud                       # default: anycloud
# RUSTFS_REGION=us-east-1                         # default: us-east-1
# PULUMI_SECRETS_PROVIDER=passphrase              # default: passphrase (or hashivault://...)
# ANYCLOUD_AGENT_IMAGE=aipaas/cluster-agent:dev   # default: aipaas/cluster-agent:latest
# ANYCLOUD_BACKEND_IMAGE_TAG=v0.0.1               # default: latest
# SECURITY_AUTH_ENABLED=false                     # default: false (static bearer token mode)
# SECURITY_AUTH_TOKEN=
# ANYCLOUD_CORS_ALLOWED_ORIGINS=                  # production: 정확한 origin 명시 (콤마 구분)
