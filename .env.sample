# anycloud 환경변수 템플릿. .env 로 복사 후 채우기.
#
# 3-tier 환경변수 정책
#   1. Dockerfile.pulumi 의 ENV : container path 고정값 (PULUMI_PROJECT_DIR 등)
#   2. config/*.yaml 의 default : 코드 기본값 (stack-prefix=anycloud 등)
#   3. docker-compose.yml       : 서비스 간 wiring, 본 파일의 secret 게이트
#
# 본 파일에는 secret 과 환경별 값만. 나머지는 yaml/Dockerfile 의 default 사용.
#
# 값 뒤 인라인 주석 금지. docker-compose v1 은 주석까지 값으로 읽음.
# 기동은 v2 (`docker compose`) 기준.

# ---------------------------------------------------------------------------
# Required secrets (8). 비우면 기동 시 fail-fast
# ---------------------------------------------------------------------------

# openssl rand -hex 24
DB_PASS=
DB_ROOT_PASS=
RABBITMQ_PASS=

# openssl rand -hex 32
RUSTFS_ROOT_PASSWORD=
PULUMI_PASSPHRASE=
ANYCLOUD_AGENT_JWT_SECRET=

# openssl rand -hex 16
OPENBAO_DEV_ROOT_TOKEN=

# CSP credential 암호화. MANUAL credential 사용 시 필수. openssl rand -hex 32
# 부팅 시 검증 : 32자 미만 거부, 알려진 sentinel ("change-me" 등) 거부
CSP_CREDENTIAL_ENCRYPTION_KEY=

# ---------------------------------------------------------------------------
# Deployment-specific (2). 환경마다 다른 값, default 없음
# ---------------------------------------------------------------------------

# 원격 cluster 의 agent pod 가 backend 로 outbound 접속할 endpoint (host:port)
#   운영     : ingress, LB, NodePort 의 public DNS (예: agent.aipaas.example.com:9090)
#   dev      : cloudflared, ngrok, tailscale public host
#   같은 LAN : 노트북 IP (예: 192.168.0.42:9090)
# localhost, host.docker.internal 은 원격 cluster 에서 NXDOMAIN 이므로 사용 불가
ANYCLOUD_AGENT_GRPC_PUBLIC_ENDPOINT=host.docker.internal:9090

# Cluster 등록 응답 (BootstrapInfo.kubectlApplyCommand) 의 curl base URL.
# 사용자 kubectl context 에서 실행할 명령에 박혀 나가므로 외부에서 도달 가능한 URL 필요.
#   운영        : agent-manifest.yaml 을 외부 노출하는 reverse-proxy, gateway URL
#                 (예: https://api.aipaas.example.com)
#   단일 컨테이너 : backend 직접 접근 URL (예: http://anycloud.example.com:8888)
#   빈 값       : 현재 HTTP 요청의 host 사용 (X-Forwarded-* 반영), 최종 fallback 은
#                 http://localhost:8888
ANYCLOUD_PUBLIC_URL=

# ---------------------------------------------------------------------------
# 영속 데이터 경로
# ---------------------------------------------------------------------------

# mariadb, rustfs 의 bind mount 루트. 운영은 별도 디스크 경로 권장 (예: /srv/anycloud).
# rustfs 에 Pulumi state 가 들어간다. 유실 시 생성한 클라우드 자원을 관리할 수 없다.
# 기동 전 소유권 필요: mariadb 1001:1001, rustfs 10001:10001
ANYCLOUD_DATA_DIR=./data

# ---------------------------------------------------------------------------
# Optional. default 는 compose 또는 config/*.yaml 보유
# ---------------------------------------------------------------------------

# 외부 Vault 용. 비우면 compose 의 OpenBao root token 사용 (dev 모드, 재시작 시 소실).
# VAULT_ADDR=
# VAULT_TOKEN=

# DB_USER=anycloud
# RABBITMQ_USER=anycloud
# RUSTFS_ROOT_USER=anycloud
# RUSTFS_REGION=us-east-1
# PULUMI_SECRETS_PROVIDER=passphrase

# 이미지. 운영에서는 tag pin 권장. latest 는 다음 push 로 조용히 바뀜
# ANYCLOUD_AGENT_IMAGE=ghcr.io/ai-paas/cluster-agent:v0.1.3-dev
# ANYCLOUD_BACKEND_IMAGE=ghcr.io/ai-paas/anycloud-backend
# ANYCLOUD_BACKEND_IMAGE_TAG=v0.0.1

# 수동 설치 (HELM_BOOTSTRAP, MANUAL) 안내의 `helm repo add` 에 들어갈 chart repo URL.
# 운영자 셸에서 도달 가능해야 함. 자동 설치 (API_MANAGED, default) 는 jar 에 packaged 된
# chart 를 쓰므로 빈 값 허용. 현재 chart publish workflow 가 없어 가리킬 대상 없음
# ANYCLOUD_AGENT_HELM_REPO_URL=

# ---------------------------------------------------------------------------
# compose 미전달 변수
#
# 아래 3개는 docker-compose.yml 의 backend environment 블록에 없어 .env 에 적어도
# 컨테이너까지 가지 않음. 적용하려면 compose 에 먼저 추가 필요
# ---------------------------------------------------------------------------
#   ANYCLOUD_CORS_ALLOWED_ORIGINS : 운영에서 정확한 origin 명시 (콤마 구분)
#   SECURITY_AUTH_ENABLED         : default false (static bearer token mode)
#   SECURITY_AUTH_TOKEN
